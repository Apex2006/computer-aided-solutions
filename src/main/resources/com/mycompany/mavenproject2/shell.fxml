<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Main window frame: top bar, side menu and the page area. @author Luis Gabriel Santiago -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.mavenproject2.ShellController">
    <top>
        <HBox styleClass="topbar">
            <HBox fx:id="logoBox" spacing="12" alignment="CENTER_LEFT" minWidth="-Infinity"/>
            <HBox fx:id="searchBox" styleClass="input-box" prefWidth="460" maxWidth="460">
                <TextField fx:id="searchField" HBox.hgrow="ALWAYS"
                           promptText="Search guides or components (e.g. soil sensor, ESP32)"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="createButton" text="Create Guide" styleClass="btn-primary" onAction="#onCreateGuide"/>
            <HBox fx:id="accountBox" alignment="CENTER_RIGHT" spacing="8"/>
        </HBox>
    </top>
    <left>
        <VBox styleClass="sidebar" prefWidth="256" minWidth="256">
            <Label text="MENU" styleClass="section-label">
                <VBox.margin><Insets left="12" bottom="8"/></VBox.margin>
            </Label>
            <VBox fx:id="navList" spacing="4"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label fx:id="roleNote" styleClass="faint,tiny" wrapText="true">
                <VBox.margin><Insets left="12" right="8"/></VBox.margin>
            </Label>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="content"/>
    </center>
</BorderPane>
